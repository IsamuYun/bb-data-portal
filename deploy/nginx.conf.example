# /etc/nginx/sites-available/bb-data-portal — HTTPS reverse proxy behind Cloudflare (SSL/TLS mode: Full (strict)).
# Replace portal.example.com with your domain (APP_URL in .env must match) and the certificate paths with
# where your Cloudflare Origin Certificate and its private key are stored.

# Visitors' real IPs from Cloudflare (logs only; the app does not use them). Keep the list current:
# https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6
# If another site on this server already sets these in http {}, delete this block.
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

server {
    listen 80;
    listen [::]:80;
    server_name portal.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name portal.example.com;

    ssl_certificate     /etc/ssl/cloudflare/portal.example.com.pem;
    ssl_certificate_key /etc/ssl/cloudflare/portal.example.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Media uploads from the extension are up to 50 MB (MAX_MEDIA_BYTES).
    client_max_body_size 60m;

    access_log /var/log/nginx/bb-data-portal.access.log;
    error_log  /var/log/nginx/bb-data-portal.error.log;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        # Profile export may wait up to 60 s for translation (Cloudflare itself gives up at 100 s).
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        # Stream uploads to the app and responses back without buffering them on disk.
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
