{
  "name": "bb-data-portal",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "pnpm --filter @bb/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @bb/db generate",
    "db:migrate": "pnpm --filter @bb/db migrate",
    "db:seed": "pnpm --filter @bb/db seed"
  },
  "engines": {
    "node": ">=20"
  }
}
