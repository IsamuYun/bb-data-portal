# --- docker compose / runtime ---
POSTGRES_USER=bb
POSTGRES_PASSWORD=bb
POSTGRES_DB=bb
POSTGRES_PORT=5432
WEB_PORT=3000
# Host address the ports bind to. Postgres stays host-only; set WEB_BIND=127.0.0.1 behind a reverse proxy.
POSTGRES_BIND=127.0.0.1
WEB_BIND=0.0.0.0

# >= 16 chars; generate with: openssl rand -hex 32
AUTH_SECRET=change-me-change-me-change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234
APP_URL=http://localhost:3000
# 翻译模型：优先用通义千问（DashScope OpenAI 兼容接口），没有则用 Claude；都没有时只翻译字典字段
QWEN_API_KEY=
# 可选：模型与地址（海外账号用 https://dashscope-intl.aliyuncs.com/compatible-mode/v1）
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选：强制指定 qwen / claude
TRANSLATE_PROVIDER=
ANTHROPIC_API_KEY=

# --- local dev (pnpm dev) ---
DATABASE_URL=postgres://bb:bb@localhost:5432/bb
MEDIA_DIR=./data/media
EXPORT_DIR=./data/exports
