{
  "manifest_version": 3,
  "name": "Fairfax Donor Exporter",
  "version": "1.4.0",
  "description": "从 Fairfax Cryobank 搜索结果中依次抓取 Donor Profile 详情，并导出为带照片的 HTML 表格",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://fairfaxcryobank.com/*",
    "https://api.anthropic.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fairfax Donor Exporter"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fairfaxcryobank.com/search/searchresults.aspx*"
      ],
      "js": [
        "vendor/pdf.worker.min.js",
        "vendor/pdf.min.js",
        "vendor/exceljs.min.js",
        "zip.js",
        "translate.js",
        "pdfimg.js",
        "excel.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}